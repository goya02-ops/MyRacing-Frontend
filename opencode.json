{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "mercadopago": {
        "type": "remote",
        "url": "https://mcp.mercadopago.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:MERCADOPAGO_ACCESS_TOKEN}"
        }
      },
      "mui": {
        "type": "local",
        "command": ["pnpm", "exec", "mcp"]
      }
    }
  }
}